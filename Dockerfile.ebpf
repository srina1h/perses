FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y \
    git curl wget unzip ca-certificates gnupg \
    build-essential python3 python3-pip \
    openjdk-11-jdk \
    ninja-build pkg-config \
    clang lld cmake \
    zlib1g-dev libtinfo5 \
    bpftrace linux-headers-generic llvm \
    sudo binutils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Bazel
RUN ARCH=$(uname -m) \
    && if [ "$ARCH" = "x86_64" ]; then \
        curl -fsSL https://github.com/bazelbuild/bazel/releases/download/7.4.1/bazel-7.4.1-linux-x86_64 -o /usr/local/bin/bazel; \
    elif [ "$ARCH" = "aarch64" ]; then \
        curl -fsSL https://github.com/bazelbuild/bazel/releases/download/7.4.1/bazel-7.4.1-linux-arm64 -o /usr/local/bin/bazel; \
    else \
        echo "Unsupported arch" && exit 1; \
    fi \
    && chmod +x /usr/local/bin/bazel \
    && bazel --version

RUN git config --global user.name "Docker Build" \
    && git config --global user.email "docker@build.local"

WORKDIR /workspace

ARG CACHE_BUST
RUN echo "Cloning perses (cache bust: ${CACHE_BUST})"
RUN git clone https://github.com/srina1h/perses.git . \
    && git checkout ebpf_recent

RUN bazel build //kitten/src/org/perses/fuzzer:kitten_deploy.jar

ENV PATH=/root/bin:$PATH
RUN mkdir -p /root/bin
COPY kitten/scripts/javascript/build_v8_normal.sh /root/bin/build_v8_normal.sh
COPY kitten/scripts/javascript/gen_allowlist_from_git.sh /root/bin/gen_allowlist_from_git.sh
COPY kitten/scripts/javascript/gen_uprobe_functions.sh /root/bin/gen_uprobe_functions.sh
COPY kitten/scripts/javascript/d8_with_bpf.sh /root/bin/d8_with_bpf.sh
COPY kitten/scripts/javascript/run_v8_ebpf_with_kitten.sh /root/bin/run_v8_ebpf_with_kitten.sh
RUN chmod +x /root/bin/*.sh

# Prepare seeds for fuzzing (trim to 100 for testing; remove SEED_LIMIT for full corpus)
RUN chmod +x /workspace/prepare_seeds.sh && SEED_LIMIT=100 /workspace/prepare_seeds.sh

# Build V8 normally, generate allowlist and uprobe list
ARG THREADS=8
ENV THREADS=${THREADS}
RUN WORKDIR=/workspace THREADS=${THREADS} /root/bin/build_v8_normal.sh
RUN GEN_REPO=/workspace/v8 GEN_SINCE_MONTHS=6 /root/bin/gen_allowlist_from_git.sh > /workspace/allowlist.txt
RUN D8_BIN=/workspace/v8/out/rel/d8 ALLOWLIST=/workspace/allowlist.txt /root/bin/gen_uprobe_functions.sh > /workspace/uprobe_functions.txt

ENV JVM_HEAP=8
ENV D8_BIN=/workspace/v8/out/rel/d8
ENV UPROBE_FUNCS_FILE=/workspace/uprobe_functions.txt

CMD ["/root/bin/run_v8_ebpf_with_kitten.sh"]


